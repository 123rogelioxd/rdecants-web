# =============================================================
#  RDECANTS — FRONTEND ROUTING (Hostinger / LiteSpeed / Apache)
#  Lives next to index.html and product.html.
#  Hostinger does NOT honor Netlify _redirects or netlify.toml;
#  this file is the authoritative production routing for the
#  static frontend.
# =============================================================

# Disable MultiViews so /product is not silently rewritten to
# /product.html before our rules run (which would break the
# /perfume/{slug} → product.html rewrite below).
Options -MultiViews

# ── MIME types the server does not know out of the box ──────
# Hostinger/LiteSpeed served .avif as `text/plain`, which also meant it
# fell outside the image cache rule and was re-downloaded on every visit.
# <picture> selects a <source> from its `type` attribute BEFORE the fetch,
# so the browser commits to the AVIF and then has to content-sniff a
# text/plain response to render it — fragile, and fatal the moment a
# nosniff policy is added. Declared explicitly instead.
<IfModule mod_mime.c>
    AddType image/avif .avif
    AddType image/webp .webp
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.html$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>

    <FilesMatch "\.js$">
        Header set Cache-Control "no-cache"
    </FilesMatch>

    # The hero photograph is content-addressed by filename (the crop and the
    # width are in the name), so it can be cached as hard as the CSS.
    <FilesMatch "\.(avif|webp)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # ── Clean URLs for the top-level experiences ─────────────
    # The storefront is three separate pages after the redesign:
    # discovery (/), the catalog, and the guided finder. These give
    # each one a short, shareable URL without a .html suffix.
    RewriteRule ^catalogo/?$          catalogo.html [L,QSA]
    RewriteRule ^elegir/?$            elegir.html   [L,QSA]
    RewriteRule ^ayudame-a-elegir/?$  elegir.html   [L,QSA]
    RewriteRule ^ayuda/?$             ayuda.html    [L,QSA]

    # ── Slug routes for product detail pages ─────────────────
    # /perfume/{slug}      → product.html
    # /perfume/{slug}/     → product.html
    # The PDP reads the slug from window.location.pathname.
    RewriteRule ^perfume/([^/]+)/?$ product.html [L,QSA]

    # ── Slug routes for mood collection pages ────────────────
    # /mood/{slug}         → mood.html
    # The mood page reads the slug from window.location.pathname.
    RewriteRule ^mood/([^/]+)/?$ mood.html [L,QSA]

    # ── SPA-safe fallback for the bare root ──────────────────
    # If a request maps to a real file or directory, serve it
    # untouched. Otherwise, fall back to index.html.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^$ index.html [L]
</IfModule>
